# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# YandexGPT (Foundation Models). Ключ сервисного аккаунта и ID каталога.
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# Канал для публикации дайджеста (бот должен быть админом канала)
CHANNEL_USERNAME=@your_channel

# Рабочие русские RSS по баскетболу (проверено). Пробелы вокруг ссылок не важны.
# Старые пути Championat/Sportbox/RIA basketball и basket.ru/rss.xml — 404 или HTML.
RSS_FEED_URLS=https://www.eurohoops.net/ru/feed/,https://www.championat.com/rss/news/basketball/,https://www.sports.ru/rss/rubric.xml?id=210,https://news.sportbox.ru/taxonomy/term/45/0/feed,https://matchtv.ru/articles/rss/basketball,https://www.sport-express.ru/services/materials/news/basketball/se/,https://www.basket.ru/news/rss

# Фильтр новостей (только русские слова, через запятую)
NEWS_KEYWORDS=баскетбол,НБА,Евролига,Еврокубок,ФИБА,ВТБ,трансфер,контракт,свободный агент,плей-офф,финал,драфт,травма,МВП
