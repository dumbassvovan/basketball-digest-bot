# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# YandexGPT (Foundation Models). Ключ сервисного аккаунта и ID каталога.
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# Канал для публикации дайджеста (бот должен быть админом канала)
CHANNEL_USERNAME=@your_channel

# Несколько RSS через запятую (пробелы вокруг ссылок не важны)
RSS_FEED_URLS=https://www.eurohoops.net/ru/feed/,https://rsport.ria.ru/export/rss2/basketball/index.xml,https://news.sportbox.ru/Vidy_sporta/Basketbol/rss,https://basket.ru/rss.xml,https://www.championat.com/basketball/rss.xml

# Фильтр новостей (только русские слова, через запятую)
NEWS_KEYWORDS=баскетбол,НБА,Евролига,Еврокубок,ФИБА,ВТБ,трансфер,контракт,свободный агент,плей-офф,финал,драфт,травма,МВП
