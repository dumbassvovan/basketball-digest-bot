# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# YandexGPT (Foundation Models). Ключ сервисного аккаунта и ID каталога.
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# Канал для публикации дайджеста (бот должен быть админом канала)
CHANNEL_USERNAME=@your_channel

# Несколько RSS через запятую (пробелы вокруг ссылок не важны)
RSS_FEED_URLS=https://www.sports.ru/rss/all.xml,https://news.ycombinator.com/rss

# Фильтр новостей (через запятую). Пустое значение — список по умолчанию.
NEWS_KEYWORDS=NBA,баскетбол,Евролига,ВТБ,basketball,Euroleague
